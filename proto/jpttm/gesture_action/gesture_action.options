# One Action encodes to at most ~24 bytes, so a page of 8 stays well inside a
# 256-byte RPC response buffer.
jpttm.gesture_action.GetActionsResponse.actions max_count:8
jpttm.gesture_action.ErrorResponse.message      max_size:64
# Eight 24-char names plus framing stays inside a 256-byte response.
jpttm.gesture_action.GetSlotNamesResponse.names max_count:8 max_size:24
# Eight groups with short names stays inside a 256-byte response.
jpttm.gesture_action.GetGroupsResponse.groups max_count:8
jpttm.gesture_action.Group.name               max_size:16
jpttm.gesture_action.GetDefaultsResponse.actions max_count:8
